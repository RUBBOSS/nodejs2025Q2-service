FROM postgres:16-alpine

ENV POSTGRES_DB=nodejs2025q2
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV PGDATA=/var/lib/postgresql/data/pgdata

RUN apk add --no-cache \
    curl \
    postgresql-contrib

RUN mkdir -p /docker-entrypoint-initdb.d
RUN mkdir -p /etc/postgresql

COPY database/init/*.sql /docker-entrypoint-initdb.d/
COPY database/scripts/*.sql /docker-entrypoint-initdb.d/


RUN chown -R postgres:postgres /docker-entrypoint-initdb.d

RUN echo "#!/bin/bash" > /docker-entrypoint-initdb.d/01-init.sql && \
    echo "-- Initialize database for nodejs2025q2 service" >> /docker-entrypoint-initdb.d/01-init.sql && \
    echo "CREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";" >> /docker-entrypoint-initdb.d/01-init.sql && \
    echo "CREATE EXTENSION IF NOT EXISTS \"pgcrypto\";" >> /docker-entrypoint-initdb.d/01-init.sql && \
    echo "" >> /docker-entrypoint-initdb.d/01-init.sql && \
    echo "-- Create additional schemas if needed" >> /docker-entrypoint-initdb.d/01-init.sql && \
    echo "-- CREATE SCHEMA IF NOT EXISTS app_schema;" >> /docker-entrypoint-initdb.d/01-init.sql

EXPOSE 5432

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD pg_isready -U $POSTGRES_USER -d $POSTGRES_DB || exit 1

CMD ["postgres"]
