# Application Configuration
PORT=4000
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=log
LOG_MAX_FILE_SIZE_KB=1024

# Authentication & Security
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=3600
JWT_SECRET_KEY=your-secret-key-here
JWT_SECRET_REFRESH_KEY=your-refresh-secret-key-here
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nodejs2025q2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nodejs2025q2

# Docker Configuration
COMPOSE_PROJECT_NAME=home-library
