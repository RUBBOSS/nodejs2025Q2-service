{
  "name": "home-library",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "dotenv -e .env.local -- jest --testMatch \"<rootDir>/*.spec.ts\" --noStackTrace --runInBand",
    "test:auth": "dotenv -e .env.local -- cross-env TEST_MODE=auth jest test/auth/ --noStackTrace --runInBand",
    "test:refresh": "dotenv -e .env.local -- cross-env TEST_MODE=auth jest --testPathPattern refresh.e2e.spec.ts --noStackTrace --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:force": "npm audit fix --force",
    "security": "npm audit && npm run security:deps && npm run security:licenses",
    "security:deps": "bash scripts/security-scan.sh",
    "security:full": "npm run security && npm run security:docker",
    "security:docker": "bash scripts/docker-security-scan.sh",
    "security:licenses": "bash scripts/license-scan.sh",
    "security:report": "bash scripts/security-report.sh",
    "security:verify": "bash scripts/verify-security.sh",
    "vulnerabilities": "npm run security:full",
    "migration:generate": "dotenv -e .env.local -- typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
    "migration:run": "dotenv -e .env.local -- typeorm-ts-node-commonjs migration:run -d ormconfig.ts",
    "migration:revert": "dotenv -e .env.local -- typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "docker:build": "docker build -t home-library-service .",
    "docker:tag": "docker tag home-library-service %DOCKERHUB_USERNAME%/home-library-service:latest",
    "docker:push": "docker push %DOCKERHUB_USERNAME%/home-library-service:latest",
    "docker:deploy": "npm run docker:build && npm run docker:tag && npm run docker:push",
    "dockerhub:deploy": "bash scripts/deploy-dockerhub.sh",
    "dockerhub:deploy:win": "scripts\\deploy-dockerhub.bat",
    "dockerhub:deploy:enhanced": "bash scripts/dockerhub-deploy.sh",
    "dockerhub:deploy:manual": "bash scripts/deploy-manual.sh",
    "dockerhub:login": "bash scripts/login-helper.sh",
    "dockerhub:verify": "bash scripts/verify-deployment.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.5",
    "http-status-codes": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
